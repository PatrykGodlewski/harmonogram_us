#!/bin/sh
# Pre-commit: Biome on staged files in Biome's scope, then typecheck of every
# workspace package with staged changes. Installed by tooling/scripts/install-hooks.mjs.
set -eu

cd "$(git rev-parse --show-toplevel)"

escape_hatch="Bypass only with a reason: git commit --no-verify (explain why in the commit body)."

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
	echo "pre-commit: nothing to check"
	exit 0
fi

if [ ! -d node_modules ]; then
	echo "pre-commit: node_modules missing — run pnpm install (or --no-verify)" >&2
	exit 1
fi

# Split lists on newlines only and never glob: staged paths may contain spaces.
nl='
'
IFS=$nl
set -f

biome_files=""
packages=""
file_count=0

add_package() {
	case "$nl$packages" in
	*"$nl$1$nl"*) ;;
	*) packages="$packages$1$nl" ;;
	esac
}

for file in $staged; do
	file_count=$((file_count + 1))

	case "$file" in
	*/routeTree.gen.ts | *paraglide/* | packages/rpc/src/gen/* | packages/db/src/migrations/* | \
		*/styles.css | */app.css | *project.inlang/.meta.json | *project.inlang/cache/*) ;;
	src/* | */src/* | */messages/*.json | */e2e/*.ts | vite.config.ts | */vite.config.ts | \
		index.html | */index.html | *project.inlang/*)
		biome_files="$biome_files$file$nl"
		;;
	esac

	case "$file" in
	apps/web/*) add_package web ;;
	apps/admin/*) add_package admin ;;
	apps/worker/*) add_package worker ;;
	packages/proto/*) ;;
	packages/*/*)
		dir=${file#packages/}
		add_package "@repo/${dir%%/*}"
		;;
	tooling/e2e/*) add_package e2e ;;
	esac
done

failed=0
summary="pre-commit: $file_count files"

if [ -n "$biome_files" ]; then
	# shellcheck disable=SC2086 # newline-split list of staged paths
	if output=$(pnpm exec biome check --no-errors-on-unmatched -- $biome_files 2>&1); then
		summary="$summary, biome ✓"
	else
		printf '%s\n' "$output" >&2
		summary="$summary, biome ✗"
		failed=1
	fi
else
	summary="$summary, biome –"
fi

for package in $packages; do
	if output=$(pnpm exec turbo typecheck --filter="$package" 2>&1); then
		summary="$summary, typecheck $package ✓"
	else
		printf '%s\n' "$output" >&2
		summary="$summary, typecheck $package ✗"
		failed=1
	fi
done

echo "$summary"

if [ "$failed" -ne 0 ]; then
	echo "pre-commit: checks failed. $escape_hatch" >&2
	exit 1
fi
