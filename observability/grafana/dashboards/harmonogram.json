        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, route, status_code) (rate(http_requests_total{status_code=~\"4..\"}[1m]))",
          "legendFormat": "{{job}} {{route}} {{status_code}}"
        }
      ]
    },
