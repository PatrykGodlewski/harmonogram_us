{
  "name": "@repo/rpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./documents": "./src/documents.ts",
    "./gen/*": "./src/gen/*.ts"
  },
  "scripts": {
    "generate": "buf generate ../../proto --template ../../proto/buf.gen.yaml",
    "build": "pnpm run generate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@repo/env": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@repo/config": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "unpdf": "^2.2.1",
    "vitest": "^5.1.1"
  }
}
