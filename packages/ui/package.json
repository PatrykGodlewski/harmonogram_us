{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": {
      "import": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./composed/*": {
      "import": "./src/composed/*.tsx",
      "default": "./src/composed/*.tsx"
    },
    "./composed/*/*": {
      "import": "./src/composed/*/*",
      "default": "./src/composed/*/*"
    },
    "./utils": "./src/utils.ts",
    "./time": "./src/time.ts",
    "./agenda": "./src/agenda.ts",
    "./tailwind": "./tailwind.css",
    "./app-errors": "./src/app-errors.ts",
    "./registrants-csv": "./src/registrants-csv.ts",
    "./registrant-stats": "./src/registrant-stats.ts",
    "./file-size": "./src/file-size.ts",
    "./session-colors": "./src/session-colors.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "add:ui": "pnpm dlx shadcn@latest add -y -o",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@repo/api": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
