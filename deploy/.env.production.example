# Production settings for deploy/compose.yml. Copy to deploy/.env.production
# (git-ignored), fill in, then run deploy/deploy.sh. Never commit the filled file.

# ——— Where the app lives ———
# The Terraform output "fqdn", e.g. harmonogram-us.germanywestcentral.cloudapp.azure.com
WEB_HOST=
BETTER_AUTH_URL=https://<WEB_HOST>
ADMIN_URL=https://<WEB_HOST>:8443
# Images: ghcr.io/<github-owner-lowercase>; TAG is the branch the images were built from.
REGISTRY=ghcr.io/patrykgodlewski
TAG=next

# ——— Database ———
# Managed database (Azure): terraform -chdir=infra/azure output -raw database_url
# Database on the server (Oracle): uncomment the three lines below, pick a password
# (openssl rand -hex 24) and use it in both places.
# COMPOSE_PROFILES=local-db
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://harmonogram:<POSTGRES_PASSWORD>@db:5432/harmonogram_us
DATABASE_URL=

# Larger servers (Oracle: 12 GB) can give each Node process more memory.
# NODE_OPTIONS=--max-old-space-size=1024

# ——— Secrets (generate fresh ones) ———
# openssl rand -base64 16
ENCRYPTION_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32 (the documents service and the apps share it)
DOCUMENTS_TOKEN=

# ——— Cloudflare Turnstile (required in production) ———
# The site key is public and baked into the images: set it as the GitHub repository
# variable VITE_TURNSTILE_SITE_KEY. The secret key goes here.
TURNSTILE_SECRET_KEY=

# ——— E-mail (any SMTP provider, e.g. Brevo or Resend) ———
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ——— Files (Cloudflare R2: a bucket with EU jurisdiction and a token limited to it) ———
S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ——— Optional ———
# PRIVACY_CONTROLLER="Uniwersytet …, ul. …"
# PRIVACY_CONTACT_EMAIL=
# METRICS_TOKEN=
