# Session encryption. At least 32 characters (e.g. openssl rand -base64 32)
SESSION_SECRET='dev-session-secret-change-in-production-min-32-chars'

# AES-128-GCM key. Must be base64-encoded 16 bytes (e.g. openssl rand -base64 16)
ENCRYPTION_KEY='MTIzNDU2Nzg5MDEyMzQ1Ng=='

# Better Auth secret. At least 32 characters.
BETTER_AUTH_SECRET='dev-better-auth-secret-change-in-production-12345'
BETTER_AUTH_URL='https://localhost:3000'
ADMIN_URL='https://localhost:3001'

# Cloudflare Turnstile (Cloudflare test keys for local development)
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'
VITE_TURNSTILE_SITE_KEY='1x00000000000000000000AA'

# HaveIBeenPwned minimum breach count threshold
HIBP_MIN_BREACH_COUNT='1'

# Installation time zone (IANA): UI, e-mails and scheduled jobs. Inlined into client builds.
VITE_APP_TIME_ZONE='Europe/Warsaw'

# Password of the local test accounts created by `pnpm db:seed` (development only)
SEED_ACCOUNT_PASSWORD='Kampus-Dev-Haslo-2026'

# Bearer token Prometheus uses for /api/metrics (unset: the endpoint answers 404). Production: a long random value.
METRICS_TOKEN='dev-metrics-token-change-me'
# Rust PDF service (services/documents): where the apps reach it and the token both sides share.
DOCUMENTS_URL=http://localhost:50051
DOCUMENTS_TOKEN='dev-documents-token-change-me-0123456789'

# PostgreSQL connection string
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/harmonogram_us'

# Local SMTP (Mailpit via Docker Compose)
SMTP_HOST='localhost'
SMTP_PORT='1025'
SMTP_FROM='noreply@localhost'

# --- Railway deployment (set on each service in the Railway dashboard) ---
#
# One Railway project, five services. Deploy from the main branch; web, admin and worker
# build from the shared /Dockerfile, chosen by the APP service variable.
#
#   1. Postgres (Railway database).
#   2. web:    Settings > Config-as-code path /apps/web/railway.toml, public domain.
#              Runs the database migrations before each deploy.
#   3. admin:  Config-as-code path /apps/admin/railway.toml, public domain.
#   4. worker: Config-as-code path /apps/worker/railway.toml, no domain.
#   5. documents: Config-as-code path /services/documents/railway.toml (Rust PDF service),
#              private only, no public domain.
#
# A project that ran the former Electric service: delete that service, then drop its
# replication slot, or Postgres keeps write-ahead log for it until the disk fills:
#   SELECT slot_name FROM pg_replication_slots;            -- electric_slot_…
#   SELECT pg_drop_replication_slot('<slot_name>');
#
# Shared variables (Project Settings > Shared Variables), referenced from web, admin and
# worker as ${{shared.NAME}}. Generate secrets with openssl rand -base64 16 / -base64 32.
#   ENCRYPTION_KEY=<base64 16 bytes>
#   BETTER_AUTH_SECRET=<min 32 chars>
#   BETTER_AUTH_URL=https://<web domain>
#   ADMIN_URL=https://<admin domain>
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM=<your mail provider>
#   VITE_APP_TIME_ZONE=Europe/Warsaw   # optional; inlined at build time
#   METRICS_TOKEN=<long random value>  # optional: enables /api/metrics for Prometheus
#   S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY=<Cloudflare R2 bucket and token, see below>
#
# web:
#   APP=web
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   TURNSTILE_SECRET_KEY=<cloudflare secret key>  # required: production refuses to start without it
#   VITE_TURNSTILE_SITE_KEY=<cloudflare site key> # inlined at build time
#   DOCUMENTS_URL=http://${{documents.RAILWAY_PRIVATE_DOMAIN}}:50051
#   DOCUMENTS_TOKEN=<random value, min 32 chars; same on documents, web and admin>
#   + the shared variables
#
# admin:
#   APP=admin
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   TURNSTILE_SECRET_KEY, VITE_TURNSTILE_SITE_KEY=<same as web>
#   DOCUMENTS_URL, DOCUMENTS_TOKEN=<same as web>
#   + the shared variables
#
# worker (e-mails, expired group places, deleting objects of removed files):
#   APP=worker
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   + the shared variables
#
# documents:
#   DOCUMENTS_TOKEN=<same as web>
#   PORT=9464  # Railway's health check probes this port (/healthz)
#   METRICS_TOKEN=<same as the shared one>  # optional: enables /metrics on port 9464

# GDPR: days after an event before its registrations are deleted; who controls the data (privacy page)
REGISTRATION_RETENTION_DAYS=365
# PRIVACY_CONTROLLER="Uniwersytet …, ul. …"
# PRIVACY_CONTACT_EMAIL=iod@uczelnia.example

# University sign-in (OpenID Connect: Entra ID, CAS 6+, Keycloak, Shibboleth behind an OIDC proxy).
# Register the app at the university with the redirect URI <BETTER_AUTH_URL>/api/auth/callback/university
# and scopes "openid email profile". All three of URL, ID and secret turn it on.
# UNIVERSITY_SSO_DISCOVERY_URL=https://login.uczelnia.example/.well-known/openid-configuration
# UNIVERSITY_SSO_CLIENT_ID=
# UNIVERSITY_SSO_CLIENT_SECRET=
# UNIVERSITY_SSO_NAME="Uniwersytet …"

# Teams meetings for online events (F23), web and admin; on when the first four are set.
# App registration with the Microsoft Graph application permission OnlineMeetings.ReadWrite.All,
# plus an application access policy (Teams PowerShell) granted to the organizer account.
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_ORGANIZER_ID=wydarzenia@uczelnia.example

# Files at events (F14): an S3-compatible bucket. Development: the `storage` container of
# docker-compose (SeaweedFS) with the values below. Production: Cloudflare R2 (bucket with EU
# jurisdiction, an R2 API token with Object Read & Write on that bucket only):
# S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# Files are off (upload hidden in the panel) unless all four are set.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=harmonogram
S3_ACCESS_KEY_ID=harmonogram-dev
S3_SECRET_ACCESS_KEY=harmonogram-dev-secret
# S3_REGION=auto
