# Session encryption. At least 32 characters (e.g. openssl rand -base64 32)
SESSION_SECRET='dev-session-secret-change-in-production-min-32-chars'

# AES-128-GCM key. Must be base64-encoded 16 bytes (e.g. openssl rand -base64 16)
ENCRYPTION_KEY='MTIzNDU2Nzg5MDEyMzQ1Ng=='

# Better Auth secret. At least 32 characters.
BETTER_AUTH_SECRET='dev-better-auth-secret-change-in-production-12345'
BETTER_AUTH_URL='http://localhost:3000'
ADMIN_URL='http://localhost:3001'

# Cloudflare Turnstile (Cloudflare test keys for local development)
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'
VITE_TURNSTILE_SITE_KEY='1x00000000000000000000AA'

# HaveIBeenPwned minimum breach count threshold
HIBP_MIN_BREACH_COUNT='1'

# Installation time zone (IANA): UI, e-mails and scheduled jobs. Inlined into client builds.
VITE_APP_TIME_ZONE='Europe/Warsaw'

# Password of the local test accounts created by `pnpm db:seed` (development only)
SEED_ACCOUNT_PASSWORD='Kampus-Dev-Haslo-2026'

# Bearer token Prometheus uses for /api/metrics (unset: the endpoint answers 404). Production: a long random value.
METRICS_TOKEN='dev-metrics-token-change-me'

# PostgreSQL connection string
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/harmonogram_us'

# Local SMTP (Mailpit via Docker Compose)
SMTP_HOST='localhost'
SMTP_PORT='1025'
SMTP_FROM='noreply@localhost'

# Electric sync service (docker-compose). Shared secret for shape API requests.
ELECTRIC_SECRET='dev-electric-secret-change-in-production'

# --- Railway deployment (set on each service in the Railway dashboard) ---
#
# One Railway project, five services. Deploy from the main branch; web, admin and worker
# build from the shared /Dockerfile, chosen by the APP service variable.
#
#   1. Postgres (Railway database). Electric needs logical replication: once, in the
#      Postgres service's Data > Query tab (or psql), run
#        ALTER SYSTEM SET wal_level = logical;
#      then restart the Postgres service. Check with SHOW wal_level;
#   2. electric: Docker image electricsql/electric (same digest as docker-compose.yml).
#      Private only, no public domain. Attach a volume at /var/lib/electric.
#        DATABASE_URL=${{Postgres.DATABASE_URL}}
#        ELECTRIC_SECRET=<long random value, same as web>
#        ELECTRIC_STORAGE_DIR=/var/lib/electric
#        ELECTRIC_DATABASE_USE_IPV6=true   # Railway's private network is IPv6
#        ELECTRIC_LISTEN_ON_IPV6=true
#   3. web:    Settings > Config-as-code path /apps/web/railway.toml, public domain.
#              Runs the database migrations before each deploy.
#   4. admin:  Config-as-code path /apps/admin/railway.toml, public domain.
#   5. worker: Config-as-code path /apps/worker/railway.toml, no domain.
#
# Shared variables (Project Settings > Shared Variables), referenced from web, admin and
# worker as ${{shared.NAME}}. Generate secrets with openssl rand -base64 16 / -base64 32.
#   ENCRYPTION_KEY=<base64 16 bytes>
#   BETTER_AUTH_SECRET=<min 32 chars>
#   BETTER_AUTH_URL=https://<web domain>
#   ADMIN_URL=https://<admin domain>
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM=<your mail provider>
#   VITE_APP_TIME_ZONE=Europe/Warsaw   # optional; inlined at build time
#   METRICS_TOKEN=<long random value>  # optional: enables /api/metrics for Prometheus
#
# web:
#   APP=web
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   ELECTRIC_URL=http://${{electric.RAILWAY_PRIVATE_DOMAIN}}:3000
#   ELECTRIC_SECRET=${{electric.ELECTRIC_SECRET}}
#   TURNSTILE_SECRET_KEY=<cloudflare secret key>  # required: production refuses to start without it
#   VITE_TURNSTILE_SITE_KEY=<cloudflare site key> # inlined at build time
#   + the shared variables
#
# admin:
#   APP=admin
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   TURNSTILE_SECRET_KEY, VITE_TURNSTILE_SITE_KEY=<same as web>
#   + the shared variables
#
# worker:
#   APP=worker
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   + the shared variables
