# Session encryption. At least 32 characters (e.g. openssl rand -base64 32)
SESSION_SECRET='dev-session-secret-change-in-production-min-32-chars'

# AES-128-GCM key. Must be base64-encoded 16 bytes (e.g. openssl rand -base64 16)
ENCRYPTION_KEY='MTIzNDU2Nzg5MDEyMzQ1Ng=='

# Better Auth secret. At least 32 characters.
BETTER_AUTH_SECRET='dev-better-auth-secret-change-in-production-12345'
BETTER_AUTH_URL='http://localhost:3000'
ADMIN_URL='http://localhost:3001'

# Cloudflare Turnstile (Cloudflare test keys for local development)
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'
VITE_TURNSTILE_SITE_KEY='1x00000000000000000000AA'

# Redis for auth rate limiting (docker-compose service)
REDIS_URL='redis://localhost:6379'
REDIS_PASSWORD=''

# HaveIBeenPwned minimum breach count threshold
HIBP_MIN_BREACH_COUNT='1'

# PostgreSQL connection string
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/harmonogram_us'

# Local SMTP (Mailpit via Docker Compose)
SMTP_HOST='localhost'
SMTP_PORT='1025'
SMTP_FROM='noreply@harmonogram.local'

# Electric sync service (docker-compose). Shared secret for shape API requests.
ELECTRIC_SECRET='dev-electric-secret-change-in-production'

# --- Railway deployment (set on each service in the Railway dashboard) ---
#
# Create a Railway project with:
#   1. PostgreSQL  -> DATABASE_URL=${{Postgres.DATABASE_URL}}
#   2. Redis       -> REDIS_URL=${{Redis.REDIS_URL}} (optional, for auth rate limiting)
#   3. web service -> Config file: /apps/web/railway.toml
#   4. admin service -> Config file: /apps/admin/railway.toml
#
# web service variables (generate secrets with openssl rand -base64 16 / -base64 32):
#   ENCRYPTION_KEY=<base64 16 bytes>
#   BETTER_AUTH_SECRET=<min 32 chars>
#   BETTER_AUTH_URL=https://<web-service-domain>
#   ADMIN_URL=https://<admin-service-domain>
#   VITE_TURNSTILE_SITE_KEY=<cloudflare site key>  # also add under Build > Variables
#
# admin service variables:
#   ENCRYPTION_KEY=<same as web>
#   BETTER_AUTH_SECRET=<same as web>
#   BETTER_AUTH_URL=https://<web-service-domain>
#   ADMIN_URL=https://<admin-service-domain>
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Optional Electric sync (deploy electricsql/electric as a separate Railway service):
#   ELECTRIC_URL=http://${{Electric.RAILWAY_PRIVATE_DOMAIN}}:3000
#   ELECTRIC_SECRET=<shared secret>
