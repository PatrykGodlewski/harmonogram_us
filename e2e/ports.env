# Host ports of the e2e stack (compose project "harmonogram-e2e"), apart from the dev stack.
WEB_PORT=3100
ADMIN_PORT=3101
DB_PORT=15432
MAILPIT_PORT=18025
SMTP_PORT_HOST=11025
PROMETHEUS_PORT=19090
GRAFANA_PORT=13002
OIDC_PORT=18080
# University sign-in against the mock (e2e/oidc-mock); the same URL works in the browser and the containers.
UNIVERSITY_SSO_DISCOVERY_URL=http://oidc.localhost:18080/.well-known/openid-configuration
UNIVERSITY_SSO_CLIENT_ID=harmonogram-e2e
UNIVERSITY_SSO_CLIENT_SECRET=e2e-only-secret
UNIVERSITY_SSO_NAME=Uniwersytet Testowy
DOCUMENTS_PORT=15051
TEAMS_PORT=18082
# Teams meetings through the stand-in Graph (e2e/teams-mock).
TEAMS_TENANT_ID=e2e-tenant
TEAMS_CLIENT_ID=e2e-teams-client
TEAMS_CLIENT_SECRET=e2e-teams-secret
TEAMS_ORGANIZER_ID=organizator@uczelnia.test
TEAMS_LOGIN_URL=http://teams.localhost:18082
TEAMS_GRAPH_URL=http://teams.localhost:18082
STORAGE_PORT=18083
