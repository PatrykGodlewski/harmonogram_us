{
  "name": "harmonogram-us",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "vite": "8.3.8",
      "@tanstack/db": "0.6.8"
    }
  },
  "scripts": {
    "deps:bump": "taze major -r -f -l -w",
    "messages:compile": "pnpm --filter @repo/i18n run compile",
    "prepare": "pnpm run messages:compile && pnpm --filter @repo/rpc generate",
    "dev": "turbo dev --filter=web --filter=admin --filter=worker",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test --concurrency=1",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:seed": "turbo db:seed",
    "clean": "turbo clean && rm -rf node_modules",
    "e2e:up": "docker compose -p harmonogram-e2e --env-file .env --env-file e2e/ports.env --profile app --profile e2e up -d --build --wait --remove-orphans && DATABASE_URL=postgresql://postgres:postgres@localhost:15432/harmonogram_us pnpm --filter @repo/db db:migrate",
    "e2e:down": "docker compose -p harmonogram-e2e --env-file .env --env-file e2e/ports.env --profile app --profile e2e down -v",
    "e2e": "pnpm --filter e2e e2e",
    "db:account": "pnpm --filter @repo/db db:account",
    "load": "pnpm --filter e2e load",
    "load:stress": "pnpm --filter e2e load:stress",
    "observability:up": "docker compose -p harmonogram-e2e --env-file .env --env-file e2e/ports.env --profile app --profile observability up -d --wait prometheus grafana",
    "proto:lint": "pnpm --filter @repo/rpc exec buf lint ../../proto",
    "rust:lint": "scripts/cargo.sh fmt --check && scripts/cargo.sh clippy --all-targets -- -D warnings",
    "rust:test": "scripts/cargo.sh test",
    "rust:build": "scripts/cargo.sh build --release",
    "load:documents": "pnpm --filter e2e load:documents"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "taze": "^19.17.2",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "FSL-1.1-ALv2"
}
